<Window x:Class="PrvniOkno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="První okno" Height="180" Width="320">
    <StackPanel Margin="20">
        <TextBlock Text="Tvoje jméno:" Margin="0,0,0,4" />
        <TextBox x:Name="nameTextBox" Margin="0,0,0,10" />

        <Button x:Name="greetButton"
                Content="Pozdravit"
                Width="120"
                HorizontalAlignment="Left"
                Click="greetButton_Click" />

        <TextBlock x:Name="resultLabel" Margin="0,15,0,0" FontWeight="Bold" />
    </StackPanel>
</Window>
