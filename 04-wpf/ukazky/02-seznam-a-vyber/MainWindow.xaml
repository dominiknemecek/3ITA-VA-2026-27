<Window x:Class="SeznamAVyber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seznam a výběr" Height="220" Width="260">
    <StackPanel Margin="20">
        <!-- Položky seznamu jde napsat rovnou v XAML, na rozdíl od
             WinForms verze, kde se plní z kódu (Items.Add). -->
        <ListBox x:Name="languageListBox" Height="100"
                 SelectionChanged="languageListBox_SelectionChanged">
            <ListBoxItem Content="C#" />
            <ListBoxItem Content="C" />
            <ListBoxItem Content="Python" />
            <ListBoxItem Content="JavaScript" />
        </ListBox>

        <TextBlock x:Name="selectionLabel" Margin="0,15,0,0"
                   Text="Zatím nic nevybráno" />
    </StackPanel>
</Window>
